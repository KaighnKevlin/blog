---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { type Post, getPosts, postKind, readingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		// posts are newest-first, so the "next" (newer) post is at i - 1.
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}
type Props = { post: Post; newer?: Post; older?: Post };

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

// Use the auto-generated title card unless the post supplies its own heroImage.
const ogImagePath = post.data.heroImage ? undefined : `/og/${post.id}.png`;
const link = (p?: Post) => p && { href: `/blog/${p.id}/`, title: p.data.title, slug: p.id };
---

<BlogPost
	{...post.data}
	ogImagePath={ogImagePath}
	kind={postKind(post)}
	minutes={readingMinutes(post)}
	newer={link(newer)}
	older={link(older)}
>
	<Content />
</BlogPost>
