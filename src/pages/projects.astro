---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_TITLE } from '../consts';
import projects from '../data/projects.json';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects — ${SITE_TITLE}`} description="Things I've built or am building." />
	</head>
	<body>
		<Header />
		<main class="projects-page">
			<header class="intro">
				<p class="kicker">The workshop</p>
				<h1>Projects</h1>
				<p class="lede">
					Things I've built or am building: apps, simulations, games, and at least one bit that
					went too far. The playable stuff that lives inside posts is over in
					<a href="/blog">Writing</a>.
				</p>
			</header>
			<div class="grid">
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main.projects-page {
		width: 1120px;
		max-width: 100%;
		padding: 3.5rem 1.25rem 1rem;
	}
	.intro {
		max-width: 720px;
		margin-bottom: 2.5rem;
	}
	.intro .kicker {
		margin: 0 0 0.6rem;
	}
	.intro h1 {
		margin: 0 0 0.75rem;
	}
	.lede {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.15rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	@media (max-width: 960px) {
		.grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 620px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
