---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import PostCover from '../components/PostCover.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import projects from '../data/projects.json';
import { getPosts, postKind } from '../lib/posts';

const posts = await getPosts();
const [featured, ...rest] = posts;
const grid = rest.slice(0, 6);
const fan = posts.filter((p) => postKind(p) === 'interactive').slice(0, 3);
const interactiveCount = posts.filter((p) => postKind(p) === 'interactive').length;
const allUrls = posts.map((p) => `/blog/${p.id}/`);
const liveProjects = projects.filter((p) => p.url).slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<div class="hero-copy">
					<p class="kicker eyebrow"><span class="dot"></span>Kaighn Kevlin · New York City</p>
					<h1>
						I build <span class="squiggle"
							>toys<svg viewBox="0 0 120 14" preserveAspectRatio="none" aria-hidden="true"
								><path d="M2 9 C 14 2, 24 2, 34 8 S 56 14, 66 8 S 88 2, 98 8 S 112 12, 118 6" /></svg
							></span
						> to win arguments.
					</h1>
					<p class="lede">
						I'm a software engineer at Google. Here I write essays you can play with: a sudoku proof
						that settled a camping feud, a 50-year housing simulator, a ladder of game AIs to beat.
						Usually because someone was wrong. Occasionally it was me.
					</p>
					<div class="actions">
						<a class="btn btn-primary" href={`/blog/${featured.id}/`}>Start with the latest <span aria-hidden="true">→</span></a>
						<button class="btn btn-ghost" id="surprise" type="button" data-urls={JSON.stringify(allUrls)}>
							<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="4"></rect><circle cx="8.5" cy="8.5" r="1.2" fill="currentColor"></circle><circle cx="15.5" cy="15.5" r="1.2" fill="currentColor"></circle><circle cx="12" cy="12" r="1.2" fill="currentColor"></circle></svg>
							Surprise me
						</button>
					</div>
					<dl class="stats">
						<div><dt>{posts.length}</dt><dd>posts</dd></div>
						<div><dt>{interactiveCount}</dt><dd>you can play with</dd></div>
						<div><dt>1</dt><dd>argument won, technically</dd></div>
					</dl>
				</div>

				<div class="fan" aria-label="Recent interactive posts">
					{
						fan.map((p, i) => (
							<a href={`/blog/${p.id}/`} class={`fan-card fan-${i}`}>
								<PostCover slug={p.id} />
								<span class="fan-label">{p.data.title}</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="section">
				<div class="section-head">
					<h2>Latest</h2>
				</div>
				<PostCard post={featured} variant="feature" />
			</section>

			<section class="section">
				<div class="section-head">
					<h2>More writing</h2>
					<a href="/blog" class="more">All {posts.length} posts <span aria-hidden="true">→</span></a>
				</div>
				<div class="grid">
					{grid.map((post) => <PostCard post={post} />)}
				</div>
			</section>

			<section class="section">
				<div class="section-head">
					<h2>Side projects</h2>
					<a href="/projects" class="more">All projects <span aria-hidden="true">→</span></a>
				</div>
				<div class="projects">
					{liveProjects.map((project) => <ProjectCard project={project} compact />)}
				</div>
			</section>

			<section class="section hello">
				<div class="hello-card">
					<p class="kicker">About</p>
					<p class="hello-text">
						Duke math &amp; CS, now in a fifth-floor walk-up in the West Village. I see the world
						in incentives and game theory, but I'm a big feeler. I write about everything, from
						economics and AI to the hard, personal stuff.
					</p>
					<a href="/about" class="more">More about me <span aria-hidden="true">→</span></a>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const btn = document.getElementById('surprise');
			btn?.addEventListener('click', () => {
				const urls: string[] = JSON.parse(btn.dataset.urls ?? '[]');
				if (urls.length) location.href = urls[Math.floor(Math.random() * urls.length)];
			});
		</script>
	</body>
</html>

<style>
	main.home {
		width: 1120px;
		max-width: 100%;
		padding: 0 1.25rem;
	}

	/* ---------- Hero ---------- */
	.hero {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 3rem;
		align-items: center;
		min-height: min(640px, 82vh);
		padding: 3.5rem 0 3rem;
	}
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 0 1.25rem;
		padding: 0.4rem 0.8rem;
		border-radius: 999px;
		background: var(--card);
		border: 1px solid var(--rule);
	}
	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--brand);
		box-shadow: 0 0 0 0 color-mix(in srgb, var(--brand) 60%, transparent);
		animation: pulse 2.4s ease-out infinite;
	}
	@keyframes pulse {
		0% {
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--brand) 55%, transparent);
		}
		70%,
		100% {
			box-shadow: 0 0 0 9px transparent;
		}
	}
	.hero h1 {
		font-size: clamp(2.8rem, 6.2vw + 0.5rem, 5.4rem);
		line-height: 0.98;
		letter-spacing: -0.045em;
		font-weight: 650;
		font-variation-settings: 'SOFT' 50;
		margin: 0 0 1.5rem;
	}
	.squiggle {
		position: relative;
		display: inline-block;
		font-style: italic;
		font-variation-settings: 'SOFT' 100, 'WONK' 1;
		color: var(--brand);
	}
	.squiggle svg {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.12em;
		width: 100%;
		height: 0.22em;
		overflow: visible;
	}
	.squiggle path {
		fill: none;
		stroke: var(--brand);
		stroke-width: 3.5;
		stroke-linecap: round;
		stroke-dasharray: 160;
		stroke-dashoffset: 160;
		animation: draw 0.9s 0.35s cubic-bezier(0.6, 0, 0.3, 1) forwards;
	}
	@keyframes draw {
		to {
			stroke-dashoffset: 0;
		}
	}
	.lede {
		max-width: 34em;
		margin: 0 0 2rem;
		font-family: var(--font-serif);
		font-size: 1.22rem;
		line-height: 1.6;
		color: var(--ink-2);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2.25rem;
		margin: 2.5rem 0 0;
		padding-top: 1.5rem;
		border-top: 1px dashed var(--rule-strong);
	}
	.stats div {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
	}
	.stats dt {
		font-family: var(--font-display);
		font-size: 1.7rem;
		font-weight: 650;
		color: var(--ink);
		letter-spacing: -0.03em;
	}
	.stats dd {
		margin: 0;
		font-size: 0.85rem;
		color: var(--muted);
	}

	/* Fanned stack of covers */
	.fan {
		position: relative;
		height: 440px;
	}
	.fan-card {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 74%;
		border-radius: 16px;
		overflow: hidden;
		background: var(--card);
		border: 6px solid var(--card);
		box-shadow: var(--shadow-lg);
		text-decoration: none;
		transform-origin: 50% 120%;
		transition:
			transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
			box-shadow 0.3s ease;
	}
	.fan-card :global(svg) {
		border-radius: 10px;
	}
	.fan-label {
		display: block;
		padding: 0.55rem 0.3rem 0.2rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.98rem;
		color: var(--ink);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.fan-0 {
		z-index: 3;
		transform: translate(-50%, -50%) translate(-6%, 14%) rotate(-4deg);
	}
	.fan-1 {
		z-index: 2;
		transform: translate(-50%, -50%) translate(10%, -16%) rotate(6deg);
	}
	.fan-2 {
		z-index: 1;
		transform: translate(-50%, -50%) translate(-18%, -36%) rotate(-11deg);
	}
	.fan:hover .fan-0 {
		transform: translate(-50%, -50%) translate(-14%, 30%) rotate(-7deg);
	}
	.fan:hover .fan-1 {
		transform: translate(-50%, -50%) translate(20%, -10%) rotate(9deg);
	}
	.fan:hover .fan-2 {
		transform: translate(-50%, -50%) translate(-24%, -48%) rotate(-15deg);
	}
	.fan .fan-card:hover {
		z-index: 4;
		box-shadow: 0 30px 60px rgba(27, 26, 23, 0.25);
	}

	/* ---------- Sections ---------- */
	.section {
		margin-top: 4.5rem;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.4rem;
	}
	.section-head h2 {
		margin: 0;
		font-size: clamp(1.6rem, 2vw + 1rem, 2.1rem);
	}
	.more {
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
	}
	.more span {
		display: inline-block;
		transition: transform 0.2s ease;
	}
	.more:hover {
		color: var(--brand-ink);
	}
	.more:hover span {
		transform: translateX(3px);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.25rem 1.75rem;
	}
	.projects {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.hello-card {
		max-width: 760px;
		margin: 0 auto;
		text-align: center;
	}
	.hello-card .kicker {
		margin: 0 0 0.75rem;
	}
	.hello-text {
		margin: 0 0 1.25rem;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 1.4vw + 0.9rem, 1.8rem);
		font-weight: 450;
		line-height: 1.35;
		letter-spacing: -0.015em;
		color: var(--ink);
		text-wrap: balance;
	}

	@media (max-width: 960px) {
		.hero {
			grid-template-columns: 1fr;
			min-height: 0;
			gap: 1rem;
			padding-top: 2.5rem;
		}
		.fan {
			height: 360px;
			max-width: 520px;
			width: 100%;
			margin: 3.5rem auto 0;
		}
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.projects {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 620px) {
		.hero {
			padding-top: 1.75rem;
		}
		.lede {
			font-size: 1.08rem;
		}
		.stats {
			gap: 0.4rem 1.4rem;
		}
		.stats dt {
			font-size: 1.4rem;
		}
		/* The "Latest" card right below covers the same ground on phones. */
		.fan {
			display: none;
		}
		.grid,
		.projects {
			grid-template-columns: 1fr;
		}
		.section {
			margin-top: 3.25rem;
		}
	}
</style>
