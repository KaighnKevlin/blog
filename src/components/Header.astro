---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="wordmark" aria-label="Kaighn — home">kaighn<span>.</span></a>
		<div class="links">
			<HeaderLink href="/blog">Writing</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<span class="divider" aria-hidden="true"></span>
			<a class="icon" href="/rss.xml" title="RSS feed">
				<span class="sr-only">RSS feed</span>
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
					<path d="M5 3a16 16 0 0 1 16 16h-3A13 13 0 0 0 5 6V3zm0 6a10 10 0 0 1 10 10h-3a7 7 0 0 0-7-7V9zm1.5 7a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5z" />
				</svg>
			</a>
			<a class="icon" href="https://www.linkedin.com/in/kaighn-kevlin-a4569b121/" target="_blank" rel="noopener" title="LinkedIn">
				<span class="sr-only">LinkedIn</span>
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
					<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
				</svg>
			</a>
			<a class="icon" href="https://github.com/KaighnKevlin" target="_blank" rel="noopener" title="GitHub">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding: 0 1.25rem;
		background: color-mix(in srgb, var(--paper) 82%, transparent);
		backdrop-filter: saturate(1.4) blur(10px);
		-webkit-backdrop-filter: saturate(1.4) blur(10px);
		border-bottom: 1px solid color-mix(in srgb, var(--rule) 70%, transparent);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1120px;
		height: 64px;
		margin: 0 auto;
	}
	.wordmark {
		font-family: var(--font-display);
		font-size: 1.6rem;
		font-weight: 700;
		letter-spacing: -0.035em;
		font-variation-settings: 'SOFT' 100, 'WONK' 1;
		color: var(--ink);
		text-decoration: none;
		line-height: 1;
	}
	.wordmark span {
		color: var(--brand);
		display: inline-block;
		transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.wordmark:hover {
		color: var(--ink);
	}
	.wordmark:hover span {
		transform: translateY(-5px) scale(1.25);
	}
	.links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.links :global(a.nav) {
		padding: 0.4rem 0.75rem;
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 550;
		color: var(--ink-2);
		text-decoration: none;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}
	.links :global(a.nav:hover) {
		background: var(--paper-2);
		color: var(--ink);
	}
	.links :global(a.nav.active) {
		background: var(--ink);
		color: var(--paper);
	}
	.divider {
		width: 1px;
		height: 20px;
		background: var(--rule-strong);
		margin: 0 0.4rem;
	}
	.icon {
		display: inline-flex;
		padding: 0.45rem;
		border-radius: 999px;
		color: var(--muted);
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}
	.icon:hover {
		background: var(--paper-2);
		color: var(--ink);
	}
	@media (max-width: 560px) {
		header {
			padding: 0 0.75rem;
		}
		nav {
			height: 56px;
		}
		.wordmark {
			font-size: 1.35rem;
		}
		.links :global(a.nav) {
			padding: 0.35rem 0.55rem;
			font-size: 0.86rem;
		}
		.divider,
		.icon {
			display: none;
		}
	}
</style>
