---
// The multiplication principle, made visible. Build a sundae across three
// stages; a branching tree shows why the counts multiply rather than add.
---

<div class="cm-widget rounded-xl border border-gray-200 p-6 my-8 bg-white">
  <div class="flex items-baseline justify-between mb-1">
    <h3 class="text-lg font-semibold">Build-a-sundae: the multiplication principle</h3>
    <span class="text-[10px] text-gray-400 uppercase tracking-wider font-mono">drag the sliders</span>
  </div>
  <p class="text-sm text-gray-600 mb-4">Pick how many options each stage offers. The tree shows every possible sundae. Notice the totals <em>multiply</em>.</p>

  <div class="grid sm:grid-cols-3 gap-4 mb-5">
    <label class="block">
      <span class="flex items-center justify-between text-sm font-medium mb-1"><span>🍨 Scoops</span><span class="font-mono text-violet-600" id="cm-a-val">3</span></span>
      <input type="range" min="1" max="4" value="3" id="cm-a" class="w-full accent-violet-500" />
    </label>
    <label class="block">
      <span class="flex items-center justify-between text-sm font-medium mb-1"><span>🍫 Sauces</span><span class="font-mono text-emerald-600" id="cm-b-val">2</span></span>
      <input type="range" min="1" max="4" value="2" id="cm-b" class="w-full accent-emerald-500" />
    </label>
    <label class="block">
      <span class="flex items-center justify-between text-sm font-medium mb-1"><span>🍒 Toppings</span><span class="font-mono text-amber-600" id="cm-c-val">3</span></span>
      <input type="range" min="1" max="4" value="3" id="cm-c" class="w-full accent-amber-500" />
    </label>
  </div>

  <div class="bg-gray-50 rounded-lg p-3 mb-4 text-center">
    <div class="font-mono text-lg sm:text-xl" id="cm-equation">3 × 2 × 3 = <span class="font-bold text-gray-900">18</span></div>
    <div class="text-xs text-gray-500 mt-1" id="cm-caption">18 different sundaes</div>
  </div>

  <div class="overflow-x-auto -mx-2 px-2">
    <svg id="cm-tree" class="block mx-auto" width="640" height="260" role="img" aria-label="Tree of sundae combinations"></svg>
  </div>
</div>

<script>
  const STAGES = [
    { id: 'a', color: '#8b5cf6', label: '🍨' },
    { id: 'b', color: '#10b981', label: '🍫' },
    { id: 'c', color: '#f59e0b', label: '🍒' },
  ];

  const svg = document.getElementById('cm-tree') as unknown as SVGSVGElement;
  const eqEl = document.getElementById('cm-equation')!;
  const capEl = document.getElementById('cm-caption')!;

  function counts() {
    return STAGES.map((s) => parseInt((document.getElementById(`cm-${s.id}`) as HTMLInputElement).value, 10));
  }

  const NS = 'http://www.w3.org/2000/svg';
  function el(name: string, attrs: Record<string, string | number>) {
    const node = document.createElementNS(NS, name);
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
    return node;
  }

  function render() {
    const [a, b, c] = counts();
    STAGES.forEach((s, i) => {
      document.getElementById(`cm-${s.id}-val`)!.textContent = String([a, b, c][i]);
    });
    const total = a * b * c;
    eqEl.innerHTML = `${a} × ${b} × ${c} = <span class="font-bold text-gray-900">${total}</span>`;
    capEl.textContent = `${total} different sundae${total === 1 ? '' : 's'}`;

    // Layout: 4 columns (root, stage A, stage B, stage C-leaves).
    const leaves = total;
    const rowH = 26;
    const height = Math.max(180, leaves * rowH + 20);
    const width = 640;
    svg.setAttribute('height', String(height));
    svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
    svg.innerHTML = '';

    const colX = [40, 220, 400, 560];
    const top = 20;

    // Leaf y positions, evenly spaced.
    const leafY = (idx: number) => top + idx * rowH + rowH / 2;

    let leafIdx = 0;
    const rootY = height / 2;

    // Draw stage A nodes; each owns a contiguous block of (b*c) leaves.
    for (let ia = 0; ia < a; ia++) {
      const aLeafStart = ia * b * c;
      const aLeafEnd = aLeafStart + b * c - 1;
      const aY = (leafY(aLeafStart) + leafY(aLeafEnd)) / 2;

      svg.appendChild(el('line', { x1: colX[0] + 14, y1: rootY, x2: colX[1] - 14, y2: aY, stroke: '#ddd6fe', 'stroke-width': 2 }));

      for (let ib = 0; ib < b; ib++) {
        const bLeafStart = aLeafStart + ib * c;
        const bLeafEnd = bLeafStart + c - 1;
        const bY = (leafY(bLeafStart) + leafY(bLeafEnd)) / 2;

        svg.appendChild(el('line', { x1: colX[1] + 14, y1: aY, x2: colX[2] - 14, y2: bY, stroke: '#a7f3d0', 'stroke-width': 1.5 }));

        for (let ic = 0; ic < c; ic++) {
          const ly = leafY(leafIdx);
          svg.appendChild(el('line', { x1: colX[2] + 14, y1: bY, x2: colX[3] - 12, y2: ly, stroke: '#fde68a', 'stroke-width': 1.25 }));
          // Leaf dot
          svg.appendChild(el('circle', { cx: colX[3], cy: ly, r: 5, fill: '#f59e0b' }));
          leafIdx++;
        }
        // Stage B node
        drawNode(colX[2], bY, '#10b981', STAGES[1].label);
      }
      // Stage A node
      drawNode(colX[1], aY, '#8b5cf6', STAGES[0].label);
    }
    // Root node
    drawNode(colX[0], rootY, '#374151', '🥣');
  }

  function drawNode(x: number, y: number, color: string, label: string) {
    svg.appendChild(el('circle', { cx: x, cy: y, r: 12, fill: '#fff', stroke: color, 'stroke-width': 2 }));
    const t = el('text', { x, y: y + 5, 'text-anchor': 'middle', 'font-size': 13 });
    t.textContent = label;
    svg.appendChild(t);
  }

  STAGES.forEach((s) => {
    document.getElementById(`cm-${s.id}`)!.addEventListener('input', render);
  });
  render();
</script>
