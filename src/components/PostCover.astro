---
/**
 * Illustrated cover art for a post, drawn as inline SVG (8:5).
 * Posts with a bespoke design are keyed by slug; anything else gets a
 * deterministic Bauhaus-style pattern seeded from its slug, so new posts
 * get a cover automatically.
 */
interface Props {
	slug: string;
	class?: string;
}
const { slug, class: className } = Astro.props;

const W = 400;
const H = 250;

function rng(seed: string) {
	let h = 1779033703 ^ seed.length;
	for (let i = 0; i < seed.length; i++) {
		h = Math.imul(h ^ seed.charCodeAt(i), 3432918353);
		h = (h << 13) | (h >>> 19);
	}
	return () => {
		h = Math.imul(h ^ (h >>> 16), 2246822507);
		h = Math.imul(h ^ (h >>> 13), 3266489909);
		return ((h ^= h >>> 16) >>> 0) / 4294967296;
	};
}

const P = {
	tomato: '#e5482f',
	marigold: '#f2b33d',
	teal: '#1f8a7a',
	cobalt: '#2f4bdc',
	plum: '#6b3fa0',
	sage: '#cfe0c3',
	sky: '#c9def2',
	blush: '#f6d6ca',
	butter: '#f7e7bd',
	night: '#15172b',
	ink: '#1b1a17',
	paper: '#fffdf9',
};

const mono = 'JetBrains Mono Variable, ui-monospace, monospace';
const sans = 'Inter Variable, ui-sans-serif, system-ui, sans-serif';
const display = 'Fraunces Variable, Georgia, serif';

// ---- Sudoku: Arto Inkala's "Everest" givens ----
const everest = [
	'800000000',
	'003600000',
	'070090200',
	'050007000',
	'000045700',
	'000100030',
	'001000068',
	'008500010',
	'090000400',
];
const sCell = 230 / 9;
const sX = (W - 230) / 2;
const sY = 10;

// ---- Connect 4 ----
const c4 = ['.......', '.......', '...T...', '..TM...', '.TMM.M.', 'TMTTMT.'];
const c4Win = new Set(['5,0', '4,1', '3,2', '2,3']);

// ---- Planet Wars ----
const starRand = rng('stars');
const stars = Array.from({ length: 70 }, () => ({
	x: starRand() * W,
	y: starRand() * H,
	r: 0.4 + starRand() * 1.1,
	o: 0.25 + starRand() * 0.7,
}));
const planets = [
	{ x: 112, y: 150, r: 40, fill: P.tomato, n: 64 },
	{ x: 292, y: 82, r: 30, fill: P.cobalt, n: 41 },
	{ x: 310, y: 196, r: 17, fill: '#7d7f93', n: 12 },
	{ x: 196, y: 52, r: 12, fill: '#7d7f93', n: 5 },
	{ x: 52, y: 52, r: 9, fill: '#7d7f93', n: 3 },
];

// ---- NYC skyline ----
const skyRand = rng('yimby');
const buildings: { x: number; w: number; h: number; fill: string; windows: { x: number; y: number }[] }[] = [];
{
	const fills = [P.ink, '#2a2f45', '#26367f', '#1d5f57'];
	let x = -6;
	while (x < W) {
		const w = 18 + Math.floor(skyRand() * 30);
		const tall = skyRand() > 0.82;
		const h = tall ? 150 + skyRand() * 60 : 50 + skyRand() * 100;
		const windows: { x: number; y: number }[] = [];
		for (let wy = H - h + 10; wy < H - 10; wy += 11) {
			for (let wx = x + 5; wx < x + w - 6; wx += 8) {
				if (skyRand() > 0.62) windows.push({ x: wx, y: wy });
			}
		}
		buildings.push({ x, w, h, fill: fills[Math.floor(skyRand() * fills.length)], windows });
		x += w + 2;
	}
}
const craneOn = buildings.reduce((a, b) => (b.h > a.h ? b : a));

// ---- Monopoly ----
const props = ['#8b5a2b', '#a9d8f0', '#d63c8f', '#f08a24', '#e0312b', '#f6d32d', '#1f9d55', '#1d4fa8'];

// ---- Counting tree ----
const tree: { x1: number; y1: number; x2: number; y2: number }[] = [];
const nodes: { x: number; y: number; r: number; leaf: boolean }[] = [];
{
	const levels = [1, 3, 9, 27];
	const xs = [46, 150, 250, 350];
	const pos = levels.map((n, li) =>
		Array.from({ length: n }, (_, i) => ({ x: xs[li], y: 14 + ((i + 0.5) * (H - 28)) / n })),
	);
	pos.forEach((lvl, li) =>
		lvl.forEach((p, i) => {
			nodes.push({ x: p.x, y: p.y, r: [7, 5.5, 4, 3][li], leaf: li === 3 });
			if (li > 0) {
				const parent = pos[li - 1][Math.floor(i / 3)];
				tree.push({ x1: parent.x, y1: parent.y, x2: p.x, y2: p.y });
			}
		}),
	);
}

// ---- Call Roulette wheel ----
const wheel = { cx: 200, cy: 138, r: 106 };
const wheelColors = [P.tomato, P.cobalt, P.teal, P.plum, P.tomato, P.cobalt, P.teal, P.plum];
const wedges = wheelColors.map((fill, i) => {
	const a0 = ((i / 8) * 360 + 10) * (Math.PI / 180);
	const a1 = (((i + 1) / 8) * 360 + 10) * (Math.PI / 180);
	const p = (a: number) => `${wheel.cx + wheel.r * Math.cos(a)},${wheel.cy + wheel.r * Math.sin(a)}`;
	return { fill, d: `M${wheel.cx},${wheel.cy} L${p(a0)} A${wheel.r},${wheel.r} 0 0 1 ${p(a1)} Z` };
});

// ---- Generative fallback ----
const genRand = rng(slug);
const genPalette = [P.tomato, P.marigold, P.teal, P.cobalt, P.plum, P.sage, P.blush, P.butter, P.ink];
const pick = () => genPalette[Math.floor(genRand() * genPalette.length)];
const tile = 84;
const gen = Array.from({ length: 15 }, (_, i) => {
	const bg = pick();
	let fg = pick();
	while (fg === bg) fg = pick();
	return {
		x: (i % 5) * tile - 10,
		y: Math.floor(i / 5) * tile - 4,
		bg,
		fg,
		shape: Math.floor(genRand() * 4),
		rot: Math.floor(genRand() * 4) * 90,
	};
});

const designs = new Set([
	'worlds-hardest-sudoku',
	'connect4',
	'planet-wars',
	'yimby-nyc',
	'monopoly-was-rage-bait',
	'mcp-was-a-dumb-protocol',
	'kaighnbot',
	'counting-combinatorics',
	'onlykaighns',
	'call-roulette',
]);
const design = designs.has(slug) ? slug : 'generative';
---

<svg
	class:list={['cover', className]}
	viewBox={`0 0 ${W} ${H}`}
	preserveAspectRatio="xMidYMid slice"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
>
	{
		design === 'worlds-hardest-sudoku' && (
			<g>
				<rect width={W} height={H} fill={P.butter} />
				<rect x={sX} y={sY} width={230} height={230} fill={P.paper} />
				<rect x={sX + 3 * sCell} y={sY} width={sCell} height={sCell} fill={P.tomato} opacity="0.9" />
				{Array.from({ length: 10 }, (_, i) => (
					<g stroke={P.ink} stroke-width={i % 3 === 0 ? 2.4 : 0.7} opacity={i % 3 === 0 ? 1 : 0.35}>
						<line x1={sX + i * sCell} y1={sY} x2={sX + i * sCell} y2={sY + 230} />
						<line x1={sX} y1={sY + i * sCell} x2={sX + 230} y2={sY + i * sCell} />
					</g>
				))}
				{everest.flatMap((row, r) =>
					[...row].map((d, c) =>
						d !== '0' ? (
							<text
								x={sX + c * sCell + sCell / 2}
								y={sY + r * sCell + sCell / 2 + 5}
								text-anchor="middle"
								font-family={mono}
								font-size="15"
								font-weight="600"
								fill={P.ink}
							>
								{d}
							</text>
						) : null,
					),
				)}
				<text
					x={sX + 3.5 * sCell}
					y={sY + sCell / 2 + 5.5}
					text-anchor="middle"
					font-family={mono}
					font-size="16"
					font-weight="700"
					fill={P.paper}
				>
					?
				</text>
			</g>
		)
	}

	{
		design === 'connect4' && (
			<g>
				<rect width={W} height={H} fill={P.sky} />
				<rect x={58} y={18} width={284} height={250} rx={16} fill={P.cobalt} />
				{c4.flatMap((row, r) =>
					[...row].map((cell, c) => {
						const cx = 80 + c * 40;
						const cy = 40 + r * 40;
						const fill = cell === 'T' ? P.tomato : cell === 'M' ? P.marigold : '#dfe9f6';
						return (
							<g>
								<circle cx={cx} cy={cy} r={15} fill={fill} />
								{cell !== '.' && <circle cx={cx} cy={cy} r={10} fill="none" stroke="rgba(0,0,0,.14)" stroke-width="2" />}
								{c4Win.has(`${r},${c}`) && <circle cx={cx} cy={cy} r={17.5} fill="none" stroke={P.paper} stroke-width="2.5" />}
							</g>
						);
					}),
				)}
				<circle cx={240} cy={-2} r={15} fill={P.marigold} />
			</g>
		)
	}

	{
		design === 'planet-wars' && (
			<g>
				<rect width={W} height={H} fill={P.night} />
				{stars.map((s) => (
					<circle cx={s.x} cy={s.y} r={s.r} fill="#fff" opacity={s.o} />
				))}
				<g stroke={P.tomato} stroke-width="1.6" stroke-dasharray="3 5" opacity="0.85">
					<line x1={150} y1={156} x2={296} y2={192} />
					<line x1={140} y1={120} x2={262} y2={88} />
				</g>
				<g stroke={P.cobalt} stroke-width="1.6" stroke-dasharray="3 5" opacity="0.9">
					<line x1={282} y1={110} x2={204} y2={60} />
				</g>
				<polygon points="228,186 218,180 218,192" fill={P.tomato} />
				<polygon points="206,104 196,101 199,112" fill={P.tomato} />
				<polygon points="240,82 250,82 244,92" fill={P.cobalt} />
				{planets.map((p) => (
					<g>
						<circle cx={p.x} cy={p.y} r={p.r + 6} fill={p.fill} opacity="0.18" />
						<circle cx={p.x} cy={p.y} r={p.r} fill={p.fill} />
						<text
							x={p.x}
							y={p.y + Math.max(4, p.r * 0.22)}
							text-anchor="middle"
							font-family={mono}
							font-size={Math.max(9, p.r * 0.6)}
							font-weight="700"
							fill="#fff"
						>
							{p.n}
						</text>
					</g>
				))}
			</g>
		)
	}

	{
		design === 'yimby-nyc' && (
			<g>
				<defs>
					<linearGradient id="yimby-sky" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0" stop-color={P.sky} />
						<stop offset="1" stop-color={P.blush} />
					</linearGradient>
				</defs>
				<rect width={W} height={H} fill="url(#yimby-sky)" />
				<circle cx={300} cy={84} r={36} fill={P.marigold} />
				{buildings.map((b) => (
					<g>
						<rect x={b.x} y={H - b.h} width={b.w} height={b.h} fill={b.fill} />
						{b.windows.map((w) => (
							<rect x={w.x} y={w.y} width={3} height={4} fill={P.marigold} opacity="0.7" />
						))}
					</g>
				))}
				<g stroke={P.marigold} stroke-width="2.5" stroke-linecap="round">
					<line x1={craneOn.x + craneOn.w / 2} y1={H - craneOn.h} x2={craneOn.x + craneOn.w / 2} y2={H - craneOn.h - 36} />
					<line x1={craneOn.x + craneOn.w / 2 - 14} y1={H - craneOn.h - 34} x2={craneOn.x + craneOn.w / 2 + 52} y2={H - craneOn.h - 34} />
					<line x1={craneOn.x + craneOn.w / 2 + 44} y1={H - craneOn.h - 34} x2={craneOn.x + craneOn.w / 2 + 44} y2={H - craneOn.h - 14} stroke-width="1.2" />
				</g>
			</g>
		)
	}

	{
		design === 'monopoly-was-rage-bait' && (
			<g>
				<rect width={W} height={H} fill={P.sage} />
				{props.map((c, i) => (
					<g transform={`translate(${22 + i * 45} 22)`}>
						<rect width={42} height={64} rx={3} fill={P.paper} stroke={P.ink} stroke-width="1.5" />
						<rect width={42} height={16} rx={3} fill={c} stroke={P.ink} stroke-width="1.5" />
					</g>
				))}
				{props.map((_, i) => (
					<g transform={`translate(${22 + i * 45} 194)`}>
						<rect width={42} height={64} rx={3} fill={P.paper} stroke={P.ink} stroke-width="1.5" />
						{i % 3 === 1 ? (
							<path d="M10 24 L21 13 L32 24 V36 H10 Z" fill={P.tomato} stroke={P.ink} stroke-width="1.2" />
						) : (
							<path d="M14 26 L21 19 L28 26 V35 H14 Z" fill="#1f9d55" stroke={P.ink} stroke-width="1.2" />
						)}
					</g>
				))}
				<text x={W / 2} y={150} text-anchor="middle" font-family={display} font-style="italic" font-weight="600" font-size="40" fill={P.ink}>
					Tax the land.
				</text>
			</g>
		)
	}

	{
		design === 'mcp-was-a-dumb-protocol' && (
			<g>
				<rect width={W} height={H} fill={P.blush} />
				<path d="M78 112 C 120 26, 280 26, 322 112" fill="none" stroke={P.ink} stroke-width="2.5" />
				<polygon points="322,112 312,98 328,100" fill={P.ink} />
				<text x={200} y={46} text-anchor="middle" font-family={mono} font-size="14" font-weight="600" fill={P.ink}>
					$ curl
				</text>
				<g stroke={P.ink} stroke-width="2" stroke-dasharray="4 4" opacity="0.5">
					<line x1={124} y1={150} x2={154} y2={150} />
					<line x1={246} y1={150} x2={276} y2={150} />
				</g>
				{[
					{ x: 32, label: 'agent' },
					{ x: 155, label: 'MCP' },
					{ x: 278, label: 'API' },
				].map((b) => (
					<g>
						<rect
							x={b.x}
							y={118}
							width={90}
							height={64}
							rx={10}
							fill={P.paper}
							stroke={P.ink}
							stroke-width="2"
							stroke-dasharray={b.label === 'MCP' ? '5 4' : undefined}
							opacity={b.label === 'MCP' ? 0.75 : 1}
						/>
						<text x={b.x + 45} y={155} text-anchor="middle" font-family={mono} font-size="15" font-weight="600" fill={P.ink}>
							{b.label}
						</text>
					</g>
				))}
				<g stroke={P.tomato} stroke-width="6" stroke-linecap="round">
					<line x1={172} y1={124} x2={228} y2={176} />
					<line x1={228} y1={124} x2={172} y2={176} />
				</g>
			</g>
		)
	}

	{
		design === 'kaighnbot' && (
			<g font-family={sans} font-size="14">
				<rect width={W} height={H} fill={P.teal} />
				<rect x={30} y={26} width={140} height={34} rx={17} fill="#e9e9eb" />
				<text x={46} y={48} fill={P.ink}>drinks thursday?</text>
				<rect x={176} y={72} width={196} height={34} rx={17} fill="#2f7bf6" />
				<text x={192} y={94} fill="#fff">Kaighn's busy. I'm free :)</text>
				<rect x={30} y={118} width={138} height={34} rx={17} fill="#e9e9eb" />
				<text x={46} y={140} fill={P.ink}>wait who is this</text>
				<rect x={302} y={164} width={70} height={34} rx={17} fill="#2f7bf6" />
				{[322, 337, 352].map((x, i) => (
					<circle cx={x} cy={181} r={4} fill="#fff" opacity={1 - i * 0.25} />
				))}
				<text x={372} y={222} text-anchor="end" font-family={mono} font-size="10" fill="#fff" opacity="0.75">
					Delivered by Claude
				</text>
			</g>
		)
	}

	{
		design === 'counting-combinatorics' && (
			<g>
				<rect width={W} height={H} fill={P.plum} />
				{tree.map((l) => (
					<line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="#fff" stroke-width="1" opacity="0.35" />
				))}
				{nodes.map((n) => (
					<circle cx={n.x} cy={n.y} r={n.r} fill={n.leaf ? P.marigold : '#fff'} />
				))}
				<text x={24} y={232} font-family={mono} font-size="13" font-weight="600" fill="#fff" opacity="0.85">
					3 × 3 × 3 = 27
				</text>
			</g>
		)
	}

	{
		design === 'onlykaighns' && (
			<g>
				<rect width={W} height={H} fill="#12a5e8" />
				{Array.from({ length: 8 }, (_, i) => (
					<rect
						x={14 + (i % 4) * 95}
						y={14 + Math.floor(i / 4) * 116}
						width={86}
						height={106}
						rx={10}
						fill="#fff"
						opacity={0.14 + (i % 3) * 0.06}
					/>
				))}
				<g transform="translate(200 112)">
					<circle r={42} fill="#fff" />
					<path d="M-12 -4 V-14 A12 12 0 0 1 12 -14 V-4" fill="none" stroke="#12a5e8" stroke-width="5" />
					<rect x={-18} y={-6} width={36} height={28} rx={5} fill="#12a5e8" />
				</g>
				<text x={200} y={196} text-anchor="middle" font-family={mono} font-size="12" font-weight="700" letter-spacing="1.5" fill="#fff">
					SUBSCRIBE TO UNLOCK
				</text>
			</g>
		)
	}

	{
		design === 'call-roulette' && (
			<g>
				<rect width={W} height={H} fill={P.marigold} />
				<circle cx={wheel.cx} cy={wheel.cy + 4} r={wheel.r + 2} fill="rgba(0,0,0,.12)" />
				{wedges.map((w) => (
					<path d={w.d} fill={w.fill} stroke={P.paper} stroke-width="2" />
				))}
				<circle cx={wheel.cx} cy={wheel.cy} r={24} fill={P.paper} stroke={P.ink} stroke-width="2" />
				<path
					transform={`translate(${wheel.cx - 10} ${wheel.cy - 10}) scale(0.84)`}
					d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"
					fill={P.ink}
				/>
				<polygon points={`${wheel.cx - 13},14 ${wheel.cx + 13},14 ${wheel.cx},40`} fill={P.ink} />
			</g>
		)
	}

	{
		design === 'generative' && (
			<g>
				{gen.map((t) => (
					<g transform={`translate(${t.x} ${t.y}) rotate(${t.rot} ${tile / 2} ${tile / 2})`}>
						<rect width={tile} height={tile} fill={t.bg} />
						{t.shape === 0 && <circle cx={tile / 2} cy={tile / 2} r={tile * 0.32} fill={t.fg} />}
						{t.shape === 1 && <path d={`M0 0 H${tile} A${tile} ${tile} 0 0 1 0 ${tile} Z`} fill={t.fg} />}
						{t.shape === 2 && <path d={`M0 ${tile} A${tile / 2} ${tile / 2} 0 0 1 ${tile} ${tile} Z`} fill={t.fg} />}
						{t.shape === 3 && <rect y={tile / 2} width={tile} height={tile / 2} fill={t.fg} />}
					</g>
				))}
			</g>
		)
	}
</svg>

<style>
	.cover {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 8 / 5;
	}
</style>
