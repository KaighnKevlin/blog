---
import { BUTTONDOWN_USERNAME } from '../consts';

interface Props {
	title?: string;
	blurb?: string;
}
const {
	title = 'Get the next one by email',
	blurb = 'New posts and playable things, straight to your inbox. No spam, unsubscribe anytime.',
} = Astro.props;
---

<div class="subscribe">
	<div class="copy">
		<h3>{title}</h3>
		<p>{blurb}</p>
	</div>
	<form
		action={`https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USERNAME}`}
		method="post"
		target="popupwindow"
	>
		<label class="sr-only" for="subscribe-email">Email address</label>
		<input id="subscribe-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
		<button type="submit">Subscribe</button>
	</form>
</div>

<style>
	.subscribe {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 1.5rem 2.5rem;
		align-items: center;
		padding: 2rem 2.25rem;
		border-radius: 20px;
		background: var(--ink);
		color: var(--paper);
		position: relative;
		overflow: hidden;
	}
	.subscribe::after {
		content: '';
		position: absolute;
		width: 170px;
		height: 170px;
		left: -60px;
		bottom: -120px;
		border-radius: 50%;
		background: var(--brand);
		opacity: 0.9;
		pointer-events: none;
	}
	.copy,
	form {
		position: relative;
		z-index: 1;
	}
	h3 {
		margin: 0 0 0.35rem;
		color: var(--paper);
		font-size: 1.5rem;
	}
	p {
		margin: 0;
		font-size: 0.95rem;
		color: color-mix(in srgb, var(--paper) 72%, transparent);
	}
	form {
		display: flex;
		gap: 0.5rem;
		padding: 0.35rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--paper) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--paper) 18%, transparent);
	}
	input {
		flex: 1;
		min-width: 0;
		padding: 0.6rem 0.9rem;
		border: none;
		border-radius: 999px;
		background: transparent;
		color: var(--paper);
		font-family: inherit;
		font-size: 16px;
	}
	input::placeholder {
		color: color-mix(in srgb, var(--paper) 45%, transparent);
	}
	input:focus {
		outline: none;
	}
	form:focus-within {
		border-color: var(--brand);
	}
	button {
		padding: 0.6rem 1.2rem;
		background: var(--brand);
		color: #fff;
		border: none;
		border-radius: 999px;
		font-family: inherit;
		font-size: 0.92rem;
		font-weight: 650;
		cursor: pointer;
		transition: background 0.15s ease;
	}
	button:hover {
		background: var(--brand-ink);
	}
	@media (max-width: 720px) {
		.subscribe {
			grid-template-columns: 1fr;
			padding: 1.6rem 1.4rem;
		}
	}
</style>
