---
import Subscribe from './Subscribe.astro';

interface Props {
	/** Hide the subscribe card (e.g. on pages that show their own). */
	subscribe?: boolean;
}
const { subscribe = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		{subscribe && <Subscribe />}
		<div class="bottom">
			<a href="/" class="wordmark">kaighn<span>.</span></a>
			<nav aria-label="Footer">
				<a href="/blog">Writing</a>
				<a href="/projects">Projects</a>
				<a href="/about">About</a>
				<a href="/rss.xml">RSS</a>
				<a href="https://www.linkedin.com/in/kaighn-kevlin-a4569b121/" target="_blank" rel="noopener">LinkedIn</a>
				<a href="https://github.com/KaighnKevlin" target="_blank" rel="noopener">GitHub</a>
			</nav>
		</div>
		<p class="fine">
			&copy; {year} Kaighn Kevlin. Views are my own, not my employer's.
		</p>
	</div>
</footer>

<style>
	footer {
		margin-top: 4rem;
		padding: 0 1.25rem 3rem;
	}
	.inner {
		max-width: 1120px;
		margin: 0 auto;
	}
	.bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
	}
	.wordmark {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 700;
		letter-spacing: -0.035em;
		font-variation-settings: 'SOFT' 100, 'WONK' 1;
		color: var(--ink);
		text-decoration: none;
	}
	.wordmark span {
		color: var(--brand);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
	}
	nav a {
		font-size: 0.9rem;
		color: var(--muted);
		text-decoration: none;
	}
	nav a:hover {
		color: var(--ink);
	}
	.fine {
		margin: 0.75rem 0 0;
		font-size: 0.8rem;
		color: var(--muted);
	}
</style>
