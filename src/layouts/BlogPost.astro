---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PostCover from '../components/PostCover.astro';
import { KIND_LABEL, type PostKind } from '../lib/posts';

type Neighbor = { href: string; title: string; slug: string };
type Props = CollectionEntry<'blog'>['data'] & {
	ogImagePath?: string;
	kind: PostKind;
	minutes: number;
	newer?: Neighbor;
	older?: Neighbor;
};

const { title, description, pubDate, updatedDate, heroImage, ogImagePath, kind, minutes, newer, older } =
	Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} ogImagePath={ogImagePath} />
		<meta property="article:published_time" content={pubDate.toISOString()} />
	</head>

	<body>
		<div class="progress" aria-hidden="true"><span></span></div>
		<Header />
		<main class="post-main">
			<article>
				<header class="post-head">
					<div class="meta">
						<a href="/blog" class="back"><span aria-hidden="true">←</span> Writing</a>
						<span class="sep" aria-hidden="true">/</span>
						<span class="kicker"><FormattedDate date={pubDate} /></span>
						<span class:list={['pill', kind]}>{KIND_LABEL[kind]}</span>
						{kind === 'essay' && <span class="kicker">{minutes} min read</span>}
					</div>
					<h1>{title}</h1>
					<p class="dek">{description}</p>
					{
						updatedDate && (
							<p class="kicker updated">
								Updated <FormattedDate date={updatedDate} />
							</p>
						)
					}
				</header>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="prose">
					<slot />
				</div>
			</article>

			<div class="end">
				<div class="byline">
					<span class="avatar" aria-hidden="true">K</span>
					<p>
						Written by <a href="/about">Kaighn Kevlin</a>, who builds toys to win arguments.
						Disagree? Good. Leave a comment below.
					</p>
				</div>

				{
					(newer || older) && (
						<nav class="neighbors" aria-label="More posts">
							{older ? (
								<a href={older.href} class="neighbor older">
									<span class="thumb"><PostCover slug={older.slug} /></span>
									<span>
										<span class="kicker">← Older</span>
										<span class="n-title">{older.title}</span>
									</span>
								</a>
							) : (
								<span />
							)}
							{newer && (
								<a href={newer.href} class="neighbor newer">
									<span>
										<span class="kicker">Newer →</span>
										<span class="n-title">{newer.title}</span>
									</span>
									<span class="thumb"><PostCover slug={newer.slug} /></span>
								</a>
							)}
						</nav>
					)
				}
			</div>
			<Comments />
		</main>
		<Footer />

		<script>
			const bar = document.querySelector<HTMLElement>('.progress span');
			const update = () => {
				const h = document.documentElement;
				const max = h.scrollHeight - h.clientHeight;
				if (bar) bar.style.transform = `scaleX(${max > 0 ? h.scrollTop / max : 0})`;
			};
			addEventListener('scroll', update, { passive: true });
			addEventListener('resize', update);
			update();
		</script>
	</body>
</html>

<style>
	.progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		z-index: 200;
		pointer-events: none;
	}
	.progress span {
		display: block;
		height: 100%;
		background: var(--brand);
		transform: scaleX(0);
		transform-origin: 0 50%;
	}
	main.post-main {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}
	.post-head {
		width: 720px;
		max-width: 100%;
		margin: 0 auto;
		padding: 3.5rem 1em 2rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 1.4rem;
	}
	.back {
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
	}
	.back span {
		display: inline-block;
		transition: transform 0.2s ease;
	}
	.back:hover span {
		transform: translateX(-3px);
	}
	.sep {
		color: var(--rule-strong);
	}
	.post-head h1 {
		margin: 0 0 1rem;
		font-size: clamp(2.2rem, 4.4vw + 1rem, 3.5rem);
		line-height: 1.04;
		letter-spacing: -0.035em;
	}
	.dek {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.3rem;
		line-height: 1.5;
		color: var(--muted);
		text-wrap: pretty;
	}
	.updated {
		margin: 1rem 0 0;
	}
	.post-head::after {
		content: '';
		display: block;
		width: 56px;
		height: 4px;
		margin-top: 2rem;
		border-radius: 4px;
		background: var(--brand);
	}
	.hero-image {
		width: 1020px;
		max-width: calc(100% - 2rem);
		margin: 0 auto 1rem;
	}
	.hero-image :global(img) {
		display: block;
		border-radius: var(--radius);
		box-shadow: var(--shadow-md);
	}
	.prose {
		width: 720px;
		max-width: 100%;
		margin: auto;
		padding: 0.5em 1em 2em;
	}

	.end {
		width: 720px;
		max-width: 100%;
		margin: 1rem auto 0;
		padding: 0 1em;
	}
	.byline {
		display: flex;
		gap: 1rem;
		align-items: center;
		padding: 1.25rem 0;
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}
	.avatar {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--ink);
		color: var(--paper);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.2rem;
	}
	.byline p {
		margin: 0;
		font-size: 0.95rem;
		color: var(--muted);
	}
	.neighbors {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 1.5rem;
	}
	.neighbor {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 0.75rem;
		border-radius: 16px;
		background: var(--card);
		border: 1px solid var(--rule);
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.neighbor.newer {
		justify-content: flex-end;
		text-align: right;
	}
	.neighbor:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}
	.thumb {
		flex-shrink: 0;
		width: 64px;
		height: 64px;
		overflow: hidden;
		border-radius: 10px;
	}
	.thumb :global(svg) {
		width: 100%;
		height: 100%;
		aspect-ratio: 1;
	}
	.neighbor .kicker {
		display: block;
		margin-bottom: 0.2rem;
	}
	.n-title {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1rem;
		line-height: 1.25;
		color: var(--ink);
	}
	.neighbor:hover .n-title {
		color: var(--brand-ink);
	}

	@media (max-width: 720px) {
		.post-head {
			padding-top: 2rem;
		}
		.dek {
			font-size: 1.12rem;
		}
		.neighbors {
			grid-template-columns: 1fr;
		}
	}
</style>
